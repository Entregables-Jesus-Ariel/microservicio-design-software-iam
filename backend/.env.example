# MySQL connection used by the backend
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ferreteria
MYSQL_USER=ferreteria_app
MYSQL_PASSWORD=replace_with_secure_password

# Authentication token settings
APP_TOKEN_SECRET=replace_with_secure_token_secret
APP_TOKEN_TTL_MINUTES=15

# HTTP server settings
APP_HTTP_PORT=8080
APP_CORS_ORIGIN=http://localhost:4200
APP_READ_TIMEOUT_SECONDS=10
APP_WRITE_TIMEOUT_SECONDS=30
APP_DB_QUERY_TIMEOUT_SECONDS=5