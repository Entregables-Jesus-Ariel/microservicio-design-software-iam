# Postgres (usa el "iam_app" login role que hagas miembro de iam_writer)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=design_software
POSTGRES_USER=iam_app
POSTGRES_PASSWORD=changeme
POSTGRES_SSLMODE=disable

# Seguridad
APP_TOKEN_SECRET=cambia-este-secreto-en-produccion
APP_TOKEN_TTL_MINUTES=15

# HTTP
APP_HTTP_PORT=8081
APP_CORS_ORIGIN=http://localhost:5173
APP_READ_TIMEOUT_SECONDS=10
APP_WRITE_TIMEOUT_SECONDS=30
APP_DB_QUERY_TIMEOUT_SECONDS=5
